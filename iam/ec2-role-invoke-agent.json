{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeKqAgentRuntimeOnly",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": [
        "arn:aws:bedrock-agentcore:ap-northeast-1:ACCOUNT_ID:runtime/RUNTIME_ID",
        "arn:aws:bedrock-agentcore:ap-northeast-1:ACCOUNT_ID:runtime/RUNTIME_ID/*"
      ]
    }
  ]
}
